# Copy values into your deployment environment; never commit real secrets.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the Authorized redirect URI configured in Google Cloud.
GOOGLE_REDIRECT_URI=https://<your-backend-host>/api/auth/google/callback

# Frontend origin only, without a trailing slash.
FRONTEND_URL=https://<your-frontend-host>

# Existing database configuration (set actual values in your secret manager / Render).
MONGO_URL=
DB_NAME=laurentia

# Required cryptographic secrets. Generate unique random values and store them in
# the deployment secret manager (e.g. Render); never reuse these examples as values.
# Suggested generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
LAURENTIA_ENCRYPTION_KEY=
LAURENTIA_SECRET_SALT=
